{
  "name": "orctl",
  "version": "0.1.0",
  "description": "OpenRouter management CLI + TUI: profiles, keys, models, usage, workspaces",
  "license": "MIT",
  "private": true,
  "type": "module",
  "bin": {
    "orctl": "src/main.ts"
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "scripts": {
    "dev": "bun run src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun test",
    "build": "bun build --compile src/main.ts --outfile dist/orctl"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@commander-js/extra-typings": "15.0.0",
    "@openrouter/sdk": "1.3.21",
    "@opentui/core": "0.5.12",
    "@opentui/react": "0.5.12",
    "@tanstack/react-query": "5.103.2",
    "commander": "15.0.0",
    "react": "19.3.0",
    "smol-toml": "1.9.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "typescript": "7.0.2"
  }
}
